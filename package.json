{
  "name": "max-web-client",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial MAX desktop web client for Windows 10",
  "author": "max-client contributors",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --test scripts/*.test.js",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "39.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "io.github.andluk87.maxclient",
    "productName": "MAX Web Client",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"], "artifactName": "MAX-Web-Client-${version}-${arch}-${target}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
